<% if (!posts || posts.length === 0) { %>
<div
  style="text-align: center; padding: 100px 40px; color: var(--text-secondary)"
>
  <p style="font-size: 18px; margin-bottom: 10px">Empty.</p>
  <p style="font-size: 14px; font-family: sans-serif; letter-spacing: 0.5px">
    For now.
  </p>
</div>
<% } else { %>
<section class="story-wheel" id="story-wheel" aria-label="Story wheel">
  <% posts.forEach((p, index) => { const excerptText = (p.excerpt || p.content
  || '').replace(/<[^>]*>/g, '').trim(); const placeholderText = excerptText ?
  excerptText.substring(0, 240) + (excerptText.length > 240 ? '...' : '') :
  'A new story waits here.'; %>
  <article
    class="story-slide <%= index === 0 ? 'is-active' : '' %>"
    data-slide-index="<%= index %>"
    aria-hidden="<%= index === 0 ? 'false' : 'true' %>"
  >
    <% if (p.coverImage) { %>
    <img src="<%= p.coverImage %>" alt="<%= p.title %>" class="story-wallpaper" />
    <% } else { %>
    <div class="story-placeholder-wallpaper">
      <p><%= placeholderText %></p>
    </div>
    <% } %>

    <div class="story-overlay"></div>

    <div class="story-content">
      <h1 class="story-title"><%= p.title %></h1>
      <a class="story-read-btn" href="/post/<%= p.slug %>">Read Story</a>
    </div>
  </article>
  <% }) %>

  <p class="story-wheel-meta">
    <span data-current-slide>1</span> / <span><%= posts.length %></span>
  </p>
</section>
<% } %>
